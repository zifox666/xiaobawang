<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ name }} - EVE 物品资料</title>
  <style>
    :root {
      --bg-main: #0f1012;
      --bg-card: #16181c;
      --bg-panel: #121418;
      --bg-row: rgba(255,255,255,.025);
      --border: rgba(255,255,255,.08);
      --border-light: rgba(255,255,255,.04);
      --text-primary: #d0d5df;
      --text-secondary: rgba(200,208,220,.55);
      --text-link: #7eacdc;
      --blue: #5590e8;
      --gold: #d9a840;
      --red: #d95555;
      --green: #4ec46e;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 820px; background: var(--bg-main); color: var(--text-primary); }
    body {
      padding: 18px;
      font-family: "Microsoft YaHei", "Noto Sans SC", Arial, sans-serif;
      background: var(--bg-main);
    }
    .card {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-card);
      box-shadow: 0 14px 34px rgba(0, 0, 0, .35);
    }
    .hero {
      position: relative;
      min-height: 210px;
      display: grid;
      grid-template-columns: 220px 1fr;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(105deg, #1b1e23 0%, #16181c 66%, #121418 100%);
    }
    .hero::after {
      content: "";
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--blue) 60%, transparent);
    }
    .visual {
      min-height: 210px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 15px;
      background:
        linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px);
      background-size: 22px 22px;
    }
    .visual img.ship { width: 210px; height: 190px; object-fit: contain; filter: drop-shadow(0 15px 14px #000); }
    .visual img.item { width: 132px; height: 132px; object-fit: contain; border-radius: 12px; filter: drop-shadow(0 12px 12px #000); }
    .identity { padding: 28px 28px 24px 22px; }
    .eyebrow {
      display: flex; gap: 8px; align-items: center;
      margin-bottom: 12px; color: var(--text-link); font-size: 13px; letter-spacing: .08em;
    }
    .tag {
      padding: 4px 9px;
      border: 1px solid rgba(126,172,220,.38);
      border-radius: 999px;
      background: rgba(85,144,232,.12);
      color: #a9cdf2;
      letter-spacing: 0;
    }
    h1 { margin: 0; color: #fff; font-size: 31px; line-height: 1.22; letter-spacing: .02em; }
    .english { margin-top: 7px; color: var(--text-secondary); font-size: 13px; }
    .idline { margin-top: 16px; color: var(--text-secondary); font-family: Consolas, monospace; font-size: 12px; }
    .market { display: flex; gap: 10px; margin-top: 15px; }
    .price { min-width: 145px; padding: 8px 11px; border-radius: 4px; background: #101216; font-size: 12px; }
    .price b { display: block; margin-top: 3px; color: #eaf6f7; font-size: 14px; }
    .price.sell { border-left: 3px solid var(--red); }
    .price.buy { border-left: 3px solid var(--green); }
    .content { padding: 22px; }
    .facts {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-bottom: 18px;
    }
    .fact { padding: 10px 12px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-panel); }
    .fact span { display: block; color: var(--text-secondary); font-size: 11px; }
    .fact b { display: block; margin-top: 4px; color: #dce8ed; font-size: 13px; font-weight: 600; }
    .section {
      margin-top: 13px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--bg-panel);
    }
    .section-title {
      display: flex; align-items: center; gap: 9px;
      margin: 0 0 12px; color: #fff; font-size: 16px; font-weight: 700;
    }
    .section-title::before { content: ""; width: 3px; height: 17px; border-radius: 2px; background: var(--gold); }
    .description { color: var(--text-primary); font-size: 13px; line-height: 1.75; white-space: pre-line; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
    .rows { display: grid; grid-template-columns: 1fr; gap: 7px; }
    .row {
      display: flex; justify-content: space-between; gap: 20px;
      padding-bottom: 7px; border-bottom: 1px solid var(--border-light);
      color: var(--text-secondary); font-size: 12px;
    }
    .row:last-child { padding-bottom: 0; border-bottom: 0; }
    .row strong { color: var(--text-primary); text-align: right; font-weight: 600; }
    .row-label { min-width: 0; display: flex; align-items: center; gap: 8px; }
    .attribute-icon {
      width: 24px; height: 24px; flex: 0 0 24px; object-fit: contain;
      border-radius: 2px; background: #0b0c0f;
    }
    .defences { display: grid; gap: 7px; }
    .defence {
      display: grid;
      grid-template-columns: 170px repeat(4, minmax(0, 1fr));
      align-items: center;
      gap: 10px;
      padding: 5px 0;
    }
    .defence-main { display: flex; align-items: center; gap: 9px; min-width: 0; }
    .defence-main img { width: 25px; height: 25px; object-fit: contain; flex: 0 0 25px; }
    .defence-name { color: var(--text-primary); font-size: 12px; }
    .hp { margin-top: 2px; color: #f0f3f7; font: 600 13px Consolas, monospace; }
    .hp small { color: var(--text-secondary); font: 10px "Microsoft YaHei", sans-serif; }
    .resist { min-width: 0; display: flex; align-items: center; gap: 4px; }
    .resist-symbol { width: 16px; height: 16px; flex: 0 0 16px; object-fit: contain; }
    .resist-track { position: relative; height: 20px; flex: 1; overflow: hidden; background: #07080a; }
    .resist-fill { position: absolute; inset: 0 auto 0 0; opacity: .98; }
    .resist.em .resist-fill { background: #087ff0; }
    .resist.thermal .resist-fill { background: #ec5b5b; }
    .resist.kinetic .resist-fill { background: #8d969d; }
    .resist.explosive .resist-fill { background: #ff9500; }
    .resist-value {
      position: relative; z-index: 1; display: block; text-align: center;
      color: #e3e8ef; font: 12px Consolas, monospace; line-height: 20px;
      text-shadow: 0 1px 2px #000;
    }
    .trait-group + .trait-group { margin-top: 12px; }
    .trait-title { margin-bottom: 6px; color: var(--text-link); font-size: 12px; font-weight: 700; }
    .trait { display: flex; gap: 7px; margin: 5px 0; color: #b6c6ce; font-size: 12px; line-height: 1.45; }
    .trait em { min-width: 44px; color: var(--gold); font-style: normal; font-weight: 700; }
    .skill-list { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 18px; }
    .skill {
      display: flex; justify-content: space-between; gap: 12px;
      color: #b4c3cb; font-size: 12px; line-height: 1.5;
    }
    .skill b { color: var(--gold); font-family: Consolas, monospace; font-size: 11px; letter-spacing: 1px; white-space: nowrap; }
    .footer {
      display: flex; justify-content: space-between;
      padding: 13px 22px; border-top: 1px solid #1d3543;
      color: #55707f; font-size: 10px; letter-spacing: .04em;
    }
    .empty { color: #708794; font-size: 12px; }
  </style>
</head>
<body>
  <article class="card">
    <header class="hero">
      <div class="visual">
        {% if is_ship %}
        <img class="ship"
             src="https://images.newdoublex.space/types/{{ type_id }}/render?size=512"
             onerror="this.onerror=null;this.className='item';this.src='https://images.newdoublex.space/types/{{ type_id }}/icon?size=128'"
             alt="{{ name }}">
        {% else %}
        <img class="item"
             src="https://images.newdoublex.space/types/{{ type_id }}/icon?size=128"
             alt="{{ name }}">
        {% endif %}
      </div>
      <div class="identity">
        <div class="eyebrow">
          <span class="tag">{{ "舰船" if is_ship else "物品" }}</span>
          <span>{{ group }} · {{ category }}</span>
        </div>
        <h1>{{ name }}</h1>
        {% if name_en != name %}<div class="english">{{ name_en }}</div>{% endif %}
        <div class="idline">TYPE ID | {{ type_id }}</div>
        {% if market.buy or market.sell %}
        <div class="market">
          {% if market.sell %}<div class="price sell">吉他最低卖单<b>{{ market.sell }}</b></div>{% endif %}
          {% if market.buy %}<div class="price buy">吉他最高买单<b>{{ market.buy }}</b></div>{% endif %}
        </div>
        {% endif %}
      </div>
    </header>

    <main class="content">
      <div class="facts">
        {% if volume %}<div class="fact"><span>体积</span><b>{{ volume }}</b></div>{% endif %}
        {% if packaged_volume %}<div class="fact"><span>打包体积</span><b>{{ packaged_volume }}</b></div>{% endif %}
        {% if mass %}<div class="fact"><span>质量</span><b>{{ mass }}</b></div>{% endif %}
        {% if capacity %}<div class="fact"><span>{{ "货舱容量" if is_ship else "容量" }}</span><b>{{ capacity }}</b></div>{% endif %}
      </div>

      {% if description %}
      <section class="section">
        <h2 class="section-title">物品描述</h2>
        <div class="description">{{ description }}</div>
      </section>
      {% endif %}

      {% if is_ship %}
        {% if traits %}
        <section class="section">
          <h2 class="section-title">舰船加成</h2>
          {% for group in traits %}
          <div class="trait-group">
            <div class="trait-title">{{ group.title }}</div>
            {% for trait in group["items"] %}
            <div class="trait"><em>{{ trait.bonus or "-" }}</em><span>{{ trait.text }}</span></div>
            {% endfor %}
          </div>
          {% endfor %}
        </section>
        {% endif %}

        <section class="section">
          <h2 class="section-title">防御</h2>
          <div class="defences">
            {% for defence in defences %}
            <div class="defence">
              <div class="defence-main">
                {% if defence.icon_url %}<img src="{{ defence.icon_url }}" alt="">{% endif %}
                <div>
                  <div class="defence-name">{{ defence.title }}值</div>
                  <div class="hp">{{ defence.hp or "—" }} <small>({{ defence.uniformity }}%)</small></div>
                </div>
              </div>
              {% for resist in defence.resists %}
              <div class="resist {{ resist.kind }}" title="{{ resist.label }}">
                <img class="resist-symbol" src="{{ resist.icon_url }}" alt="{{ resist.label }}">
                <div class="resist-track">
                  <div class="resist-fill" style="width: {{ resist.percent }}%"></div>
                  <span class="resist-value">{{ resist.value }}</span>
                </div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </section>

        <div class="grid-2">
          <section class="section">
            <h2 class="section-title">装配</h2>
            <div class="rows">
              {% for row in fitting %}<div class="row"><span>{{ row.label }}</span><strong>{{ row.value }}</strong></div>{% endfor %}
            </div>
          </section>
          <div>
            <section class="section">
              <h2 class="section-title">推进</h2>
              <div class="rows">
                {% for row in propulsion %}{% if row.value %}<div class="row"><span>{{ row.label }}</span><strong>{{ row.value }}</strong></div>{% endif %}{% endfor %}
              </div>
            </section>
            <section class="section">
              <h2 class="section-title">传感器</h2>
              <div class="rows">
                {% for row in sensors %}{% if row.value %}<div class="row"><span>{{ row.label }}</span><strong>{{ row.value }}</strong></div>{% endif %}{% endfor %}
              </div>
            </section>
          </div>
        </div>
      {% else %}
        <div class="grid-2">
          {% if fitting %}
          <section class="section">
            <h2 class="section-title">装配</h2>
            <div class="rows">
              {% for row in fitting %}
              <div class="row">
                <span class="row-label">
                  <img class="attribute-icon"
                       src="{{ row.icon_url or 'https://images.newdoublex.space/types/' ~ type_id ~ '/icon?size=32' }}"
                       alt="">
                  {{ row.label }}
                </span>
                <strong>{{ row.value }}</strong>
              </div>
              {% endfor %}
            </div>
          </section>
          {% endif %}
          {% if attributes %}
          <section class="section">
            <h2 class="section-title">属性</h2>
            <div class="rows">
              {% for row in attributes %}
              <div class="row">
                <span class="row-label">
                  <img class="attribute-icon"
                       src="{{ row.icon_url or 'https://images.newdoublex.space/types/' ~ type_id ~ '/icon?size=32' }}"
                       alt="">
                  {{ row.label }}
                </span>
                <strong>{{ row.value }}</strong>
              </div>
              {% endfor %}
            </div>
          </section>
          {% endif %}
        </div>
      {% endif %}

      {% if skills %}
      <section class="section">
        <h2 class="section-title">所需技能</h2>
        <div class="skill-list">
          {% for skill in skills %}
          <div class="skill"><span>{{ skill.name }} {{ skill.level }}</span><b>{{ skill.level_marks }}</b></div>
          {% endfor %}
        </div>
      </section>
      {% endif %}
    </main>

    <footer class="footer">
      <span>小霸王机器人 · 物品信息</span>
    </footer>
  </article>
</body>
</html>
